{
    "name": "bjornbasar/karhu-skeleton",
    "description": "Skeleton app for the karhu PHP microframework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "bjornbasar/karhu": "^0.1.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "serve": "php -S localhost:8080 -t public",
        "test": "phpunit"
    }
}
